#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <netinet/in.h>

#define BUFFER_SIZE 1024
#define PORT 5000

int main(int argc, char *argv[])
{
    int sock;

    struct sockaddr_in server_addr;

    char filename[BUFFER_SIZE];

    char buffer[BUFFER_SIZE];


    /* =================================
       CHECK SERVER IP
       ================================= */

    if (argc != 2)
    {
        printf("Usage: %s <server_ip>\n",
               argv[0]);

        return 1;
    }


    /* =================================
       CREATE SOCKET
       ================================= */

    sock =
        socket(AF_INET,
               SOCK_STREAM,
               0);


    if (sock < 0)
    {
        perror("Socket creation failed");

        return 1;
    }


    /* =================================
       SERVER ADDRESS
       ================================= */

    memset(&server_addr,
           0,
           sizeof(server_addr));


    server_addr.sin_family =
        AF_INET;

    server_addr.sin_port =
        htons(PORT);


    if (inet_pton(AF_INET,
                  argv[1],
                  &server_addr.sin_addr) <= 0)
    {
        printf("Invalid IP address!\n");

        close(sock);

        return 1;
    }


    /* =================================
       CONNECT TO SERVER
       ================================= */

    if (connect(sock,
                (struct sockaddr *)&server_addr,
                sizeof(server_addr)) < 0)
    {
        perror("Connection failed");

        close(sock);

        return 1;
    }


    printf("\n========================================\n");
    printf("          FTP CLIENT CONNECTED\n");
    printf("========================================\n");

    printf("Server IP : %s\n",
           argv[1]);

    printf("Port      : %d\n",
           PORT);


    /* =================================
       GET FILE NAME
       ================================= */

    printf("\nEnter file name to download: ");

    fgets(filename,
          BUFFER_SIZE,
          stdin);


    filename[strcspn(filename, "\r\n")] =
        '\0';


    /* =================================
       SEND FILE NAME
       ================================= */

    if (send(sock,
             filename,
             strlen(filename),
             0) < 0)
    {
        perror("Send failed");

        close(sock);

        return 1;
    }


    /* =================================
       RECEIVE RESPONSE
       ================================= */

    memset(buffer,
           0,
           sizeof(buffer));


    int n =
        recv(sock,
             buffer,
             BUFFER_SIZE - 1,
             0);


    if (n <= 0)
    {
        printf("Server disconnected!\n");

        close(sock);

        return 1;
    }


    buffer[n] = '\0';


    /* =================================
       SERVER FULL
       ================================= */

    if (strcmp(buffer,
               "ERROR: Server Full") == 0)
    {
        printf("\n========================================\n");
        printf("       SERVER FULL\n");
        printf("========================================\n");

        printf("Maximum 5 systems are already connected.\n");
        printf("Please try again later.\n");

        close(sock);

        return 0;
    }


    /* =================================
       FILE NOT FOUND
       ================================= */

    if (strncmp(buffer,
                "ERROR",
                5) == 0)
    {
        printf("\nServer: %s\n",
               buffer);

        close(sock);

        return 0;
    }


    /* =================================
       SUCCESS
       ================================= */

    if (strcmp(buffer,
               "SUCCESS") == 0)
    {
        printf("\nServer: SUCCESS\n");

        printf("Receiving file...\n");
    }
    else
    {
        printf("Unexpected response: %s\n",
               buffer);

        close(sock);

        return 1;
    }


    /* =================================
       CREATE OUTPUT FILE
       ================================= */

    char output_file[BUFFER_SIZE];


    snprintf(output_file,
             sizeof(output_file),
             "received_%s",
             filename);


    FILE *file =
        fopen(output_file,
              "wb");


    if (file == NULL)
    {
        printf("Cannot create output file!\n");

        close(sock);

        return 1;
    }


    /* =================================
       RECEIVE FILE DATA
       ================================= */

    while (1)
    {
        n =
            recv(sock,
                 buffer,
                 BUFFER_SIZE,
                 0);


        if (n <= 0)
        {
            break;
        }


        fwrite(buffer,
               1,
               n,
               file);
    }


    fclose(file);


    printf("\n========================================\n");
    printf("       FILE TRANSFER COMPLETE\n");
    printf("========================================\n");

    printf("Saved as: %s\n",
           output_file);


    /* =================================
       CLEANUP
       ================================= */

    close(sock);

    return 0;
}
