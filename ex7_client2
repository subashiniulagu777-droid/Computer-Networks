#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <netinet/in.h>

#define PORT 5000
#define BUFFER_SIZE 1024

int main(int argc, char *argv[])
{
    int sock;

    struct sockaddr_in serv_addr;

    char ip_request[BUFFER_SIZE] = {0};
    char buffer[BUFFER_SIZE] = {0};


    /*
       Check command-line argument
    */

    if (argc != 2)
    {
        printf("Usage: %s <Server_IP>\n",
               argv[0]);

        return 1;
    }


    /*
       Create socket
    */

    sock =
        socket(AF_INET,
               SOCK_STREAM,
               0);


    if (sock < 0)
    {
        perror("Socket creation error");

        return 1;
    }


    /*
       Server address
    */

    memset(&serv_addr,
           0,
           sizeof(serv_addr));


    serv_addr.sin_family =
        AF_INET;

    serv_addr.sin_port =
        htons(PORT);


    /*
       Convert IP address
    */

    if (inet_pton(AF_INET,
                  argv[1],
                  &serv_addr.sin_addr) <= 0)
    {
        printf("Invalid address configuration.\n");

        close(sock);

        return 1;
    }


    /*
       Connect to server
    */

    if (connect(sock,
                (struct sockaddr *)&serv_addr,
                sizeof(serv_addr)) < 0)
    {
        perror("Connection Failed");

        close(sock);

        return 1;
    }


    /*
       Connected
    */

    printf("\n====================================\n");
    printf("   Connected to Concurrent ARP Server\n");
    printf("====================================\n");

    printf("Server IP : %s\n",
           argv[1]);

    printf("Port      : %d\n\n",
           PORT);


    /*
       Get IP address from user
    */

    printf("Enter IP address to search: ");

    fgets(ip_request,
          BUFFER_SIZE,
          stdin);


    ip_request[strcspn(ip_request,
                       "\n\r")] = '\0';


    /*
       Send IP address to server
    */

    if (send(sock,
             ip_request,
             strlen(ip_request),
             0) < 0)
    {
        perror("Send failed");

        close(sock);

        return 1;
    }


    /*
       Receive server response
    */

    memset(buffer,
           0,
           sizeof(buffer));


    int bytes_received =
        recv(sock,
             buffer,
             BUFFER_SIZE - 1,
             0);


    if (bytes_received <= 0)
    {
        printf("Server disconnected.\n");

        close(sock);

        return 1;
    }


    buffer[bytes_received] = '\0';


    /*
       SERVER FULL
    */

    if (strcmp(buffer,
               "Server full! Maximum 5 clients.") == 0)
    {
        printf("\n====================================\n");
        printf("Server is full!\n");
        printf("Maximum 5 systems are already connected.\n");
        printf("Try again later.\n");
        printf("====================================\n");

        close(sock);

        return 0;
    }


    /*
       Check ARP result
    */

    if (strncmp(buffer,
                "FOUND:",
                6) == 0)
    {
        printf("\n--- ARP Match Found ---\n");

        printf("IP Address  : %s\n",
               ip_request);

        printf("MAC Address : %s\n",
               buffer + 6);

        printf("-----------------------\n");
    }


    /*
       IP NOT FOUND
    */

    else if (strcmp(buffer,
                    "NOT_FOUND") == 0)
    {
        printf("\nIP Address '%s' not found in ARP table.\n",
               ip_request);


        char choice;


        printf("Would you like to add it to the table? (y/n): ");

        scanf(" %c",
              &choice);

        getchar();


        /*
           Add new ARP entry
        */

        if (choice == 'y' ||
            choice == 'Y')
        {
            char mac_input[BUFFER_SIZE];


            printf("Enter corresponding MAC address ");
            printf("(e.g., 00:11:22:33:44:55): ");


            fgets(mac_input,
                  BUFFER_SIZE,
                  stdin);


            mac_input[strcspn(mac_input,
                              "\n\r")] = '\0';


            /*
               Create ADD message

               Format:
               ADD:IP:MAC
            */

            char add_msg[BUFFER_SIZE];


            snprintf(add_msg,
                     sizeof(add_msg),
                     "ADD:%s:%s",
                     ip_request,
                     mac_input);


            /*
               Send ADD request
            */

            if (send(sock,
                     add_msg,
                     strlen(add_msg),
                     0) < 0)
            {
                perror("Send failed");

                close(sock);

                return 1;
            }


            /*
               Receive confirmation
            */

            memset(buffer,
                   0,
                   sizeof(buffer));


            bytes_received =
                recv(sock,
                     buffer,
                     BUFFER_SIZE - 1,
                     0);


            if (bytes_received > 0)
            {
                buffer[bytes_received] =
                    '\0';


                if (strcmp(buffer,
                           "ADDED_SUCCESSFULLY") == 0)
                {
                    printf("\nSuccessfully added!\n");

                    printf("IP  : %s\n",
                           ip_request);

                    printf("MAC : %s\n",
                           mac_input);
                }

                else if (strcmp(buffer,
                                "TABLE_FULL") == 0)
                {
                    printf("\nARP Table is full!\n");
                }

                else
                {
                    printf("Failed to add entry.\n");
                }
            }
        }

        else
        {
            printf("Exiting directly.\n");
        }
    }


    /*
       Unknown response
    */

    else
    {
        printf("Unknown response from server: %s\n",
               buffer);
    }


    /*
       Close socket
    */

    close(sock);


    return 0;
}
