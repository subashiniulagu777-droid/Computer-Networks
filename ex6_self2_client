#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>
#include <sys/socket.h>

#define PORT 7000
#define MSG_BUFFER 1024

typedef struct {
    int cmd_type;
    int movie_id;
    int ticket_count;
    int booking_id;
} Request;

typedef struct {
    int status;
    char message[MSG_BUFFER];
} Response;

int main() {
    int sock;
    struct sockaddr_in server_addr;
    Request req;
    Response res;
    int menu_input;

    sock = socket(AF_INET, SOCK_STREAM, 0);
    if (sock < 0) { perror("Socket setup error"); return 1; }

    memset(&server_addr, 0, sizeof(server_addr));
    server_addr.sin_family = AF_INET;
    server_addr.sin_port = htons(PORT);
    server_addr.sin_addr.s_addr = inet_addr("127.0.0.1");

    if (connect(sock, (struct sockaddr *)&server_addr, sizeof(server_addr)) < 0) {
        perror("Connection to Ticket Office Server failed");
        close(sock);
        return 1;
    }

    printf("Successfully connected to Movie Ticket Booking System.\n");

    while (1) {
        printf("\n================ BOX OFFICE MENU ================\n");
        printf("1. View Movie List & Details\n");
        printf("2. Check Seat Availability\n");
        printf("3. Book Movie Tickets\n");
        printf("4. Cancel Existing Ticket Booking\n");
        printf("5. Display Specific Booking Details\n");
        printf("6. Disconnect & Exit\n");
        printf("Select Options (1-6): ");
        if (scanf("%d", &menu_input) != 1) break;

        if (menu_input == 6) break;

        memset(&req, 0, sizeof(Request));
        req.cmd_type = menu_input;

        if (menu_input == 2) {
            printf("Enter Movie ID: ");
            scanf("%d", &req.movie_id);
        } else if (menu_input == 3) {
            printf("Enter Movie ID: ");
            scanf("%d", &req.movie_id);
            printf("Enter Number of Tickets to buy: ");
            scanf("%d", &req.ticket_count);
        } else if (menu_input == 4 || menu_input == 5) {
            printf("Enter Booking Receipt ID: ");
            scanf("%d", &req.booking_id);
        } else if (menu_input != 1) {
            printf("Invalid choice. Try again.\n");
            continue;
        }

        // Send payload block to server
        send(sock, &req, sizeof(Request), 0);

        // Await evaluation execution string
        memset(&res, 0, sizeof(Response));
        if (recv(sock, &res, sizeof(Response), 0) <= 0) {
            printf("Connection drops from booking terminal environment.\n");
            break;
        }

        printf("\n[BOX OFFICE RESPONSE]:\n%s\n", res.message);
    }

    close(sock);
    printf("Thank you for using our booking platform. Goodbye!\n");
    return 0;
}
