#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <pthread.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <netinet/in.h>

#define PORT 5000
#define MAX_CLIENTS 5
#define BUFFER_SIZE 1024

struct Client
{
    int socket;
    int id;
    int active;
};

struct Client clients[MAX_CLIENTS];

int client_count = 0;

pthread_mutex_t client_lock = PTHREAD_MUTEX_INITIALIZER;


/* =================================
   CLIENT HANDLER THREAD
   ================================= */

void *client_handler(void *arg)
{
    int client_id = *(int *)arg;

    free(arg);

    int client_socket;

    pthread_mutex_lock(&client_lock);

    client_socket = clients[client_id - 1].socket;

    pthread_mutex_unlock(&client_lock);

    char buffer[BUFFER_SIZE];

    while (1)
    {
        memset(buffer, 0, sizeof(buffer));

        int n = recv(client_socket,
                     buffer,
                     BUFFER_SIZE - 1,
                     0);

        if (n <= 0)
        {
            printf("\nClient%d disconnected.\n",
                   client_id);

            pthread_mutex_lock(&client_lock);

            clients[client_id - 1].active = 0;

            pthread_mutex_unlock(&client_lock);

            break;
        }

        buffer[n] = '\0';

        printf("\nClient%d: %s\n",
               client_id,
               buffer);

        /* Client sends exit */

        if (strcmp(buffer, "exit") == 0)
        {
            char goodbye[] = "Goodbye!";

            send(client_socket,
                 goodbye,
                 strlen(goodbye),
                 0);

            printf("Server -> Client%d: %s\n",
                   client_id,
                   goodbye);

            pthread_mutex_lock(&client_lock);

            clients[client_id - 1].active = 0;

            pthread_mutex_unlock(&client_lock);

            break;
        }
    }

    close(client_socket);

    return NULL;
}


/* =================================
   SERVER INPUT THREAD
   ================================= */

void *server_input(void *arg)
{
    char message[BUFFER_SIZE];

    while (1)
    {
        int id;

        printf("\n====================================\n");
        printf("SERVER CHAT\n");
        printf("====================================\n");

        printf("Enter Client ID to reply (1-%d): ",
               MAX_CLIENTS);

        scanf("%d", &id);

        getchar();

        if (id < 1 || id > MAX_CLIENTS)
        {
            printf("Invalid Client ID!\n");
            continue;
        }

        pthread_mutex_lock(&client_lock);

        if (!clients[id - 1].active)
        {
            pthread_mutex_unlock(&client_lock);

            printf("Client%d is not connected.\n",
                   id);

            continue;
        }

        int client_socket =
            clients[id - 1].socket;

        pthread_mutex_unlock(&client_lock);

        printf("Message to Client%d: ",
               id);

        fgets(message,
              sizeof(message),
              stdin);

        message[strcspn(message, "\n")] = '\0';

        if (strlen(message) == 0)
        {
            continue;
        }

        int sent =
            send(client_socket,
                 message,
                 strlen(message),
                 0);

        if (sent < 0)
        {
            printf("Message sending failed!\n");
        }
        else
        {
            printf("\nServer -> Client%d: %s\n",
                   id,
                   message);
        }
    }

    return NULL;
}


/* =================================
   MAIN SERVER
   ================================= */

int main()
{
    int server_socket;
    int client_socket;

    struct sockaddr_in server_addr;
    struct sockaddr_in client_addr;

    socklen_t client_addr_len;

    pthread_t input_thread;


    /* =================================
       CREATE SERVER SOCKET
       ================================= */

    server_socket =
        socket(AF_INET,
               SOCK_STREAM,
               0);

    if (server_socket < 0)
    {
        perror("Socket creation failed");
        return 1;
    }


    /* =================================
       REUSE PORT
       ================================= */

    int option = 1;

    setsockopt(server_socket,
               SOL_SOCKET,
               SO_REUSEADDR,
               &option,
               sizeof(option));


    /* =================================
       SERVER ADDRESS
       ================================= */

    memset(&server_addr,
           0,
           sizeof(server_addr));

    server_addr.sin_family =
        AF_INET;

    server_addr.sin_addr.s_addr =
        INADDR_ANY;

    server_addr.sin_port =
        htons(PORT);


    /* =================================
       BIND
       ================================= */

    if (bind(server_socket,
             (struct sockaddr *)&server_addr,
             sizeof(server_addr)) < 0)
    {
        perror("Bind failed");

        close(server_socket);

        return 1;
    }


    /* =================================
       LISTEN
       ================================= */

    if (listen(server_socket,
               MAX_CLIENTS) < 0)
    {
        perror("Listen failed");

        close(server_socket);

        return 1;
    }


    printf("\n====================================\n");
    printf("       CONCURRENT CHAT SERVER\n");
    printf("====================================\n");

    printf("Port          : %d\n", PORT);
    printf("Maximum       : %d Clients\n", MAX_CLIENTS);

    printf("Waiting for clients...\n");


    /* =================================
       SERVER INPUT THREAD
       ================================= */

    if (pthread_create(&input_thread,
                       NULL,
                       server_input,
                       NULL) != 0)
    {
        perror("Thread creation failed");

        close(server_socket);

        return 1;
    }

    pthread_detach(input_thread);


    /* =================================
       ACCEPT CLIENTS
       ================================= */

    while (1)
    {
        client_addr_len =
            sizeof(client_addr);

        client_socket =
            accept(server_socket,
                   (struct sockaddr *)&client_addr,
                   &client_addr_len);

        if (client_socket < 0)
        {
            perror("Accept failed");
            continue;
        }


        /* =================================
           CHECK MAXIMUM 5 CLIENTS
           ================================= */

        pthread_mutex_lock(&client_lock);

        int free_slot = -1;
        int i;
        for (i = 0; i < MAX_CLIENTS; i++)
        {
            if (!clients[i].active)
            {
                free_slot = i;
                break;
            }
        }

        pthread_mutex_unlock(&client_lock);


        if (free_slot == -1)
        {
            char full[] =
                "Server full! Maximum 5 clients.";

            send(client_socket,
                 full,
                 strlen(full),
                 0);

            close(client_socket);

            printf("\nConnection rejected - Server full!\n");

            continue;
        }


        /* =================================
           ASSIGN CLIENT ID
           ================================= */

        int id = free_slot + 1;

        pthread_mutex_lock(&client_lock);

        clients[free_slot].socket =
            client_socket;

        clients[free_slot].id =
            id;

        clients[free_slot].active =
            1;

        pthread_mutex_unlock(&client_lock);


        printf("\n------------------------------------\n");

        printf("Client%d connected successfully!\n",
               id);

        printf("IP   : %s\n",
               inet_ntoa(client_addr.sin_addr));

        printf("Port : %d\n",
               ntohs(client_addr.sin_port));

        printf("------------------------------------\n");


        /* =================================
           ALLOCATE CLIENT ID
           ================================= */

        int *client_id =
            malloc(sizeof(int));

        if (client_id == NULL)
        {
            printf("Memory allocation failed!\n");

            close(client_socket);

            pthread_mutex_lock(&client_lock);

            clients[free_slot].active = 0;

            pthread_mutex_unlock(&client_lock);

            continue;
        }

        *client_id = id;


        /* =================================
           CREATE CLIENT THREAD
           ================================= */

        pthread_t thread;

        if (pthread_create(&thread,
                           NULL,
                           client_handler,
                           client_id) != 0)
        {
            perror("Thread creation failed");

            close(client_socket);

            pthread_mutex_lock(&client_lock);

            clients[free_slot].active = 0;

            pthread_mutex_unlock(&client_lock);

            free(client_id);
        }
        else
        {
            pthread_detach(thread);
        }
    }


    close(server_socket);

    pthread_mutex_destroy(&client_lock);

    return 0;
}
