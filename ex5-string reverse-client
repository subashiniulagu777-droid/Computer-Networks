#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/socket.h>
#include <arpa/inet.h>

#define PORT 8558
#define BUFFER_SIZE 1024

/* Same structure as server */
struct Packet
{
    char data[BUFFER_SIZE];
    int length;
};

int main(int argc, char *argv[])
{
    int client_socket;
    struct sockaddr_in server_addr;
    struct Packet packet;

    /* Validate that the server IP argument was provided */
    if (argc != 2)
    {
        printf("Usage: %s <Server_IP_Address>\n", argv[0]);
        printf("Example: %s 127.0.0.1\n", argv[0]);
        return 1;
    }

    /* Create UDP socket */
    client_socket = socket(AF_INET, SOCK_DGRAM, 0);
    if (client_socket < 0)
    {
        perror("Socket creation failed");
        return 1;
    }

    /* Configure Server address using command line argument */
    server_addr.sin_family = AF_INET;
    server_addr.sin_port = htons(PORT);
    server_addr.sin_addr.s_addr = inet_addr(argv[1]);

    printf("====================================\n");
    printf("     UDP STRING REVERSE CLIENT\n");
    printf("====================================\n");
    printf("Target Server IP: %s on Port: %d\n", argv[1], PORT);

    /* Client loop: Input string, send it, receive reversed version */
    while (1)
    {
        printf("\nEnter string to send: ");
        fgets(packet.data, BUFFER_SIZE, stdin);

        /* Remove trailing newline character */
        packet.data[strcspn(packet.data, "\n")] = '\0';
        packet.length = strlen(packet.data);

        /* Send packet to the server */
        sendto(client_socket,
               (char *)&packet,
               sizeof(packet),
               0,
               (struct sockaddr *)&server_addr,
               sizeof(server_addr));

        /* Exit condition check */
        if (strcmp(packet.data, "exit") == 0)
        {
            printf("Exit signal sent. Stopping client.\n");
            break;
        }

        printf("Waiting for server response...\n");

        /* Receive the reversed packet back from the server */
        socklen_t server_len = sizeof(server_addr);
        int n = recvfrom(client_socket,
                         (char *)&packet,
                         sizeof(packet),
                         0,
                         (struct sockaddr *)&server_addr,
                         &server_len);

        if (n < 0)
        {
            perror("Error receiving packet from server");
            break;
        }

        /* Display received processed details */
        printf("\n====================================\n");
        printf("         RECEIVED RESPONSE\n");
        printf("====================================\n");
        printf("Reversed string : %s\n", packet.data);
        printf("String Length   : %d\n", packet.length);
        printf("====================================\n");
    }

    close(client_socket);
    return 0;
}
